#!/bin/bash
# Screenshot the iPhone app on Mac mini 2 (run scripts/rb <name> ios first).
# Usage: scripts/shot <name> <screen> [wait_seconds=4] [extra launch args...]
#   <screen>: today|trends|insight|experiment|tag|onboarding|report|settings  (passed as -screen)
#   extra args go to the app, e.g.  -expDay 6
# Saves shots/<name>-<screen>[-tag].png in your checkout and prints the path. Look at it with the Read tool.
# Set SHOT_TAG=xyz to add a suffix to the file name. Set KEEP_RUNNING=1 to leave the app open.
set -uo pipefail
NAME=${1:?usage}; SCREEN=${2:?usage}; WAIT=${3:-4}; shift 3 2>/dev/null || shift $#
EXTRA="$*"
ROOT=$(cd "$(dirname "$0")/.." && pwd)
source "$ROOT/scripts/common.sh"
TAG=${SHOT_TAG:+-$SHOT_TAG}
OUT="$ROOT/shots/$NAME-$SCREEN$TAG.png"; mkdir -p "$ROOT/shots"
rssh bash -s <<REMOTE
set -e
DEV="ET-$NAME-iPhone"
UDID=\$(xcrun simctl list devices available | grep "\$DEV (" | grep -oE '[0-9A-F-]{36}' | head -1)
if [ -z "\$UDID" ]; then
  RT=$IOS_RUNTIME
  UDID=\$(xcrun simctl create "\$DEV" $IPHONE_TYPE \$RT)
fi
xcrun simctl boot \$UDID 2>/dev/null || true
xcrun simctl bootstatus \$UDID -b >/dev/null
xcrun simctl status_bar \$UDID override --time 9:41 --batteryState charged --batteryLevel 100 --cellularBars 4 --wifiBars 3 >/dev/null 2>&1 || true
xcrun simctl install \$UDID et/$NAME/dd/Build/Products/Debug-iphonesimulator/EczemaTwin.app
xcrun simctl terminate \$UDID $IOS_BUNDLE >/dev/null 2>&1 || true
xcrun simctl launch \$UDID $IOS_BUNDLE -screen $SCREEN $EXTRA >/dev/null
sleep $WAIT
xcrun simctl io \$UDID screenshot --type=png /tmp/et-$NAME-$SCREEN.png >/dev/null 2>&1
[ "${KEEP_RUNNING:-0}" = 1 ] || xcrun simctl terminate \$UDID $IOS_BUNDLE >/dev/null 2>&1 || true
REMOTE
scp -q "${SSH_OPTS[@]}" "$HOST:/tmp/et-$NAME-$SCREEN.png" "$OUT" && echo "$OUT"
